{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 27, "patch": 0},
  "configurePresets": [{
    "name": "base",
    "hidden": true,
    "generator": "Ninja",
    "binaryDir":"${sourceDir}/build/${presetName}",
    "cacheVariables":{
      "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
    }
  },{
    "name": "debug",
    "displayName": "Debug + Asan/UBSan",
    "inherits": "base",
    "cacheVariables": {
      "CMAKE_BUILD_TYPE": "Debug",
      "ENABLE_SANITIZERS": "ON"
    }
  },{
    "name": "lint",
    "displayName": "Debug + clang-tidy + cppcheck + -Werror",
    "inherits": "base",
    "cacheVariables": {
      "CMAKE_BUILD_TYPE": "Debug",
      "ENABLE_SANITIZERS": "OFF",
      "ENABLE_CLANG_TIDY": "ON",
      "ENABLE_CPPCHECK": "ON",
      "WARNINGS_AS_ERRORS": "ON"
    }
  },{
    "name": "valgrind",
    "displayName": "Debug, no sanitizers (for Valgrind)",
    "inherits":"base",
    "cacheVariables":{
      "CMAKE_BUILD_TYPE":"Debug",
      "ENABLE_SANITIZERS":"OFF"
    }
  },{
    "name":"coverage",
    "displayName":"Debug + gcov",
    "inherits":"base",
    "cacheVariables": {
      "CMAKE_BUILD_TYPE": "Debug",
      "ENABLE_SANITIZERS": "OFF",
      "ENABLE_COVERAGE": "ON"
    }
  },{
    "name":"release",
    "displayName":"Hardened release",
    "inherits": "base",
    "cacheVariables":{
      "CMAKE_BUILD_TYPE":"Release",
      "ENABLE_SANITIZERS":"OFF"
    }
  }],
  "buildPresets": [
    {"name": "debug", "configurePreset": "debug"},
    {"name": "lint", "configurePreset": "lint"},
    {"name": "valgrind", "configurePreset": "valgrind"},
    {"name": "coverage", "configurePreset": "coverage"},
    {"name": "release", "configurePreset": "release"}
  ]
}
